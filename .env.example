APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
TRUST_PROXY=0
NUMERAL_SYSTEM=latn
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=veelad_local
DB_USER=root
DB_PASSWORD=
DB_TLS=false
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
UPLOAD_DIR=var/uploads
MAIL_ENABLED=false
# Enable enforcement only after SMTP and a verification delivery test work.
EMAIL_VERIFICATION_REQUIRED=false
MAIL_FROM=info@veelad.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TEST_RECIPIENT=
MANUAL_TEST_PAYMENTS=true
MAIL_WORKER_INTERVAL_SECONDS=60

BACKUP_ENABLED=false
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24

# Google OAuth credentials belong in private environment settings.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Read-only Moyasar test connection check. Live payment processing is not enabled.
MOYASAR_TEST_ENABLED=false
MOYASAR_TEST_SECRET_KEY=

# Veelad Partners is off until commissions, reviewed costs, terms and payment
# evidence integration have been verified. No automatic bank transfers exist.
PARTNERS_ENABLED=false
# Separate 32-byte AES key in base64. Keep a private recovery copy outside backups.
PARTNERS_PAYOUT_ENCRYPTION_KEY=
# Comma-separated existing administrator account IDs; empty denies finance access.
PARTNERS_FINANCE_ADMIN_IDS=

# Creative hub is available in local/test/staging; production requires explicit enablement.
# Explicit false disables it in any environment.
CREATIVE_EXPERIENCES_ENABLED=

# Non-payment shopping improvements default on for local/staging review.
SHOP_ENHANCEMENTS_ENABLED=

# Artist profile drafts, shop presentation and following; production requires explicit enablement.
ARTIST_PROFILES_ENABLED=
