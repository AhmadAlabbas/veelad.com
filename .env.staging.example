APP_ENV=staging
APP_ORIGIN=https://staging.veelad.com
PORT=3000
TRUST_PROXY=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=veelad_staging
DB_USER=REPLACE_WITH_STAGING_DB_USER
DB_PASSWORD=REPLACE_IN_HOSTINGER_ENVIRONMENT
DB_TLS=false
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
UPLOAD_DIR=/REPLACE_WITH_PERSISTENT_PRIVATE_PATH/staging/uploads
MAIL_ENABLED=false
MAIL_FROM=orders@veelad.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=orders@veelad.com
SMTP_PASSWORD=
MAIL_TEST_RECIPIENT=
MANUAL_TEST_PAYMENTS=true
MAIL_WORKER_INTERVAL_SECONDS=60

BACKUP_ENABLED=true
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24
