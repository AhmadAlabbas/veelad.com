APP_ENV=production
APP_ORIGIN=https://veelad.com
PORT=3000
TRUST_PROXY=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=veelad_production
DB_USER=REPLACE_WITH_PRODUCTION_DB_USER
DB_PASSWORD=REPLACE_IN_HOSTINGER_ENVIRONMENT
DB_TLS=false
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
UPLOAD_DIR=/REPLACE_WITH_PERSISTENT_PRIVATE_PATH/production/uploads
MAIL_ENABLED=false
MAIL_FROM=orders@veelad.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MANUAL_TEST_PAYMENTS=false
PRODUCTION_MARKETPLACE_ENABLED=false
MAIL_WORKER_INTERVAL_SECONDS=0
